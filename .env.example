# OpenAI-compatible gateway used by the main chat route.
# GEMINI_BASE_URL / GEMINI_API_KEY / GEMINI_MODEL are still accepted as legacy aliases,
# but new setups should prefer OPENAI_COMPAT_*.
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_COMPAT_API_KEY=replace-with-your-key
OPENAI_COMPAT_MODEL=gemini-2.5-flash
# OPENAI_COMPAT_REASONING_EFFORT=medium

# Workspaces shown in the picker. Defaults to the parent directory of this repo.
# WORKSPACE_BASE_DIR=/absolute/path/to/your/projects

# Optional explicit ripgrep binary. If unset, the app tries @vscode/ripgrep,
# then system `rg`, then a slower Node-based search fallback.
# RIPGREP_PATH=/opt/homebrew/bin/rg

# Conversation compaction.
COMPACTION_THRESHOLD_TOKENS=60000
COMPACTION_KEEP_RECENT=8
CHAT_OUTER_STEP_LIMIT=500

# Local persistence store for sessions and metadata.
AGENT_STORAGE_DIR=.data

# Tool and sandbox behavior.
AI_SDK_LOGGING=true
DOTENV_FILE_APPROVAL=false
SANDBOX_ENABLED=false
# SANDBOX_ALLOWED_DOMAINS=registry.npmjs.org,github.com,*.github.com
