# ============================================================
# Gateway (LLM provider) — at least one of GEMINI_* / OPENAI_COMPAT_*
# 必须配；env.ts 在加载期就会校验，没 API key 整个应用启动失败
# ============================================================

# 选项 A：OpenAI-compatible gateway（推荐，覆盖更广）
OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_COMPAT_API_KEY=your-api-key-here
OPENAI_COMPAT_MODEL=gpt-5.5
# 推理模型才支持。可选值：minimal / low / medium / high
# 关掉（注释 / 删行）= 用 provider 默认（一般 medium）
# 注意：开高了 TTFB 会涨 8-15 秒，dev 期建议关掉
# OPENAI_COMPAT_REASONING_EFFORT=high

# 选项 B：Gemini 风格（向下兼容，跟上面 OPENAI_COMPAT_* 二选一即可）
# GEMINI_BASE_URL=http://127.0.0.1:8317/v1
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# Workspace & client behavior
# ============================================================

# Agent loop 跑在哪一端。
#  - server （默认）—— 主聊天 /api/chat 用 ToolLoopAgent，服务端跑完整 loop
#  - client          —— 主聊天 + workflow agent 节点都用前端驱动 single-step + streaming
# 必须 NEXT_PUBLIC_*：客户端要读这个值来选择 hook。
NEXT_PUBLIC_AGENT_LOOP_MODE=server

# 工作区扫描的根目录（picker 会从这下面找子目录）
# 默认是 process.cwd() 的父目录
# WORKSPACE_BASE_DIR=/Users/you/Desktop/project

# AI SDK logging middleware 显式开关。true / false / 不设
# 不设时按 NODE_ENV：dev=on，production=off
# AI_SDK_LOGGING=true

# ============================================================
# Persistence & sandbox
# ============================================================

# 持久化存储根目录。默认 ~/.local-agent/。
# 改名时只动这一处；老数据 mv 到新路径即可继续用。
# 注意：项目重命名时 *不* 应该改这个路径——故意起的中性名。
# AGENT_STORAGE_DIR=~/.local-agent

# read / write / edit 命中 .env* 路径时是否弹审批卡。默认 false（关）。
# 打开后能挡住模型不小心读 / 覆盖凭据文件，但日常编辑 .env.example 也会多弹一次。
# codex / claude-code 都没做这层（前者靠 OS sandbox，后者靠 ML classifier）。
DOTENV_FILE_APPROVAL=false

# OS 级沙箱（@anthropic-ai/sandbox-runtime / 同 claude-code 底层）。默认 false（关）。
# 打开后 shell 工具的每条命令会包到 sandbox-exec (mac) / bwrap (linux) 里跑。
# - macOS：开箱即用
# - Linux：需要 `apt install bubblewrap` / `dnf install bubblewrap`，没装会软回退
# - Windows：不支持，软回退
SANDBOX_ENABLED=false

# 沙箱网络白名单（逗号分隔域名）。仅当 SANDBOX_ENABLED=true 时生效。
# 不配 = 全 deny；npm install / git push 之类要联网的需要在这里加。
# 例：SANDBOX_ALLOWED_DOMAINS=registry.npmjs.org,github.com,*.github.com
SANDBOX_ALLOWED_DOMAINS=

# ============================================================
# Compaction (P4-b) — 对话太长时自动压缩
# ============================================================

# 对话总 token（粗估）超过这个数就触发一次 handoff 摘要。
# 默认 60_000；生产可以往 300_000+ 调（看模型 context window）。
# COMPACTION_THRESHOLD_TOKENS=60000

# 压缩后保留最近这么多条原消息逐字传给模型，其余压成 summary 层。
# 8 是 codex 风格的手感。
# COMPACTION_KEEP_RECENT=8

# 主聊天 workflow 外层 for 循环步数上限（防失控死循环）。
# 默认 500，对齐 open-agents 的 maxSteps。
# CHAT_OUTER_STEP_LIMIT=500

# ============================================================
# spawn_agent — 子 agent 递归 + 深度
# ============================================================

# spawn_agent 递归深度上限。0=主，1=子，2=孙……
# 默认 2（主→子→孙）。设 1 = 不允许递归（只准主→子一层）。
# SUBAGENT_MAX_DEPTH=2

# ============================================================
# Memory pipeline (A1-A4)
# ============================================================

# Memory 抽取器（A2 Phase 1）专用模型。
# 不配 → 用主对话同一个 model，省心但费 token。
# 配便宜模型省钱（gpt-5-mini / deepseek-v4-flash 等）。
# 同一个 env 也用于 Phase 2 整合器（共享配置；要分档未来加 MEMORY_CONSOLIDATOR_MODEL）。
# MEMORY_EXTRACTOR_MODEL=deepseek-v4-flash

# MEMORY.md 注入 system prompt 的字符上限。默认 8000（≈ 2000 token）。
# 大型用户 / 团队 memory 可调高 20000，再多请走"按需拉"模式。
# AGENT_MEMORY_MAX_CHARS=8000

# 是否启用 memory 系统（A1+A2+A3+A4 一刀切）的另一套配置在
# `~/.local-agent/settings.json` 里（{"memoryEnabled": false}）。
# 项目级也能覆盖（<workspace>/.agents/settings.json）。
# 这是文件配置，不在这个 .env 里。
